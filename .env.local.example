# Supabase project URL (Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Public anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Service role key (NEVER expose to the browser — server only)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public site URL — used to build tracking URLs and QR codes
# Locally: http://localhost:3000
# On Vercel: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random string used to hash visitor IPs before storage (privacy)
IP_HASH_SALT=change-me-to-a-long-random-string
